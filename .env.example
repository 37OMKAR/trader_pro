# Market AI — Trading Firm Environment Configuration

# LLM Providers (Configure at least one to enable live LLM generation, or leave blank to use high-fidelity deterministic engine)
DEFAULT_LLM_PROVIDER=gemini # Options: gemini, openai, claude, mock

# Google Gemini API
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# OpenAI API
OPENAI_API_KEY=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Optional Web & News Research
TAVILY_API_KEY=

# Optional Messaging & Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_KEY=

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./market_ai.db
REDIS_URL=redis://localhost:6379/0

# App Server
PORT=8000
ENVIRONMENT=development
